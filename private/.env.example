# Put real local credentials in this directory if you do not want them near the
# open-source project root. Then point the CLI at the file:
#
#   FEISHU_ENV_FILE=private/local.env feishu-bot doctor
#
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace_me
FEISHU_USER_ID=ou_xxx
FEISHU_OFFICE_STATE_FILE=private/office-projects.json
