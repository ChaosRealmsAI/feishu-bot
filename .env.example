FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace_me
FEISHU_USER_ID=ou_xxx

# Optional user-token APIs: tasks "my tasks", docs/message search, minutes search,
# mail send, Wiki space creation/search, and host-level meeting operations.
FEISHU_USER_ACCESS_TOKEN=u_xxx
FEISHU_REFRESH_TOKEN=r_xxx
FEISHU_OAUTH_REDIRECT_URI=http://localhost:8080/callback

# Optional default Wiki destination.
FEISHU_WIKI_SPACE_ID=wiki_space_id
FEISHU_WIKI_PARENT_NODE_TOKEN=wiki_parent_node_token
FEISHU_DOC_CREATE_WIKI_DEFAULT=false

# Optional local state override for `feishu-bot office ...` project registry.
FEISHU_OFFICE_STATE_FILE=private/office-projects.json

# Optional Helpdesk APIs.
FEISHU_HELPDESK_ID=helpdesk_id
FEISHU_HELPDESK_TOKEN=helpdesk_token

# Optional Lark global endpoint.
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=replace_me
